{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:a/:b",
      "destination": "/api/index"
    },
    {
      "source": "/api/:a/:b/:c",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/[...path].py": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}